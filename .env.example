# ============================================================
# SOC & ITSM Platform — root environment template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR OWN real values.
# Never commit `.env`. All values below are fake placeholders.
# The app fails loudly at startup if a secret is missing.
# ============================================================

# --- Postgres -------------------------------------------------
# Used by docker-compose.yml -> postgres service. Only applied on the
# FIRST initialization of an EMPTY data volume. For fresh clones, set
# it equal to DB_PASS so the app role and admin role stay in sync.
POSTGRES_PASSWORD=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Application database (main.py DB_* + docker-compose.yml) --
DB_HOST=jira-db
DB_NAME=soc_jira
DB_USER=soc_jira
DB_PASS=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Authentication & API secrets (REQUIRED, no defaults) ------
# JWT signing key (main.py JWT_SECRET). Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32
# Shared key for onboarding webhooks (main.py ONBOARD_API_KEY)
ONBOARD_API_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
# Internal service-to-service token key (main.py SERVICE_TOKEN_KEY)
SERVICE_TOKEN_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
# External webhook verification secret (main.py WEBHOOK_SECRET)
WEBHOOK_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Session / token expiry (non-secret config, safe to leave) --
JWT_EXPIRY_HOURS=3
AUTH_TOKEN_TTL_SECONDS=1800

# --- CORS allowlist ---------------------------------------------
# Comma-separated origins allowed to call the API cross-origin.
# The default deployment serves app + API from the same host via nginx,
# so leaving this EMPTY is the safe restrictive default (same-origin only).
# Example: https://soc.example.com,https://app.example.com
CORS_ORIGINS=

# --- Redis -------------------------------------------------------
# Used by the redis service (requirepass). The app does not currently
# connect to Redis, but keep it secret anyway.
REDIS_PASSWORD=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Active Directory / LDAPS ------------------------------------
# main.py authenticates users by BINDING to AD with the user's OWN
# credentials (UPN = username@LDAP_DOMAIN). Set LDAP_AUTH_ENABLED=false
# to use local database password auth only.
LDAP_SERVER=REPLACE_ME_with_your_ad_hostname_or_ip
LDAP_PORT=636
LDAP_DOMAIN=REPLACE_ME_with_your_ad_domain
LDAP_AUTH_ENABLED=true

# -----------------------------------------------------------------
# Optional vars that are safe to drop if not needed by your setup:
#   LDAP_CA_CERT=       (path to AD CA cert, unused by the app today)
#   LDAP_SEARCH_BASE=   (unused by the app today)
# -----------------------------------------------------------------
N8N_HOST=your-host.your-tailnet.ts.net
# n8n editor access is protected by nginx basic auth. Before starting the stack,
# create frontend/.n8n.htpasswd with: printf 'n8n:%s\n' "$(openssl passwd -apr1)" > frontend/.n8n.htpasswd && chmod 644 frontend/.n8n.htpasswd
# Keep that file local only; it is ignored by Git and mounted read-only into nginx.

# --- Owner account and test (seed_users.py) --------------------------------
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=REPLACE_ME_with_a_strong_owner_password
SEED_OWNER_FULL_NAME=System Administrator
TEST_USER_SOC_EMAIL=soc.analyst@example.com
TEST_USER_SOC_PASSWORD=REPLACE_ME_with_a_strong_test_password
TEST_USER_NOC_EMAIL=noc.analyst@example.com
TEST_USER_NOC_PASSWORD=REPLACE_ME_with_a_strong_test_password
TEST_USER_IT_SUPPORT_EMAIL=it.support@example.com
TEST_USER_IT_SUPPORT_PASSWORD=REPLACE_ME_with_a_strong_test_password