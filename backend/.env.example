# ============================================================
# backend/.env.example — environment for backend scripts run
# outside Docker (seed_users.py, sync_ad_users.py).
# ------------------------------------------------------------
# Copy this file to backend/.env and fill in YOUR OWN values.
# Note: the Docker containers do NOT read this file — they get
# their environment from the root .env via docker-compose.yml.
# ============================================================

# --- Database (REQUIRED, no defaults) -------------------------
DB_HOST=jira-db
DB_NAME=soc_jira
DB_USER=soc_jira
DB_PASS=REPLACE_ME_generate_with_openssl_rand_hex_32
DB_PORT=5432

# --- Owner account — seed_users.py (REQUIRED, no defaults) ---
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=REPLACE_ME_with_a_strong_owner_password

# --- Test accounts — seed_users.py (REQUIRED, no defaults) ----
# Store these same values in your vault / automated test setup.
TEST_USER_SOC_EMAIL=soc.analyst@example.com
TEST_USER_SOC_PASSWORD=REPLACE_ME_with_a_strong_test_password
# Optional display metadata for the SOC test user:
TEST_USER_SOC_FULL_NAME=SOC Analyst
TEST_USER_SOC_DEPARTMENT=SOC
TEST_USER_SOC_ROLE=SOC Analyst

TEST_USER_NOC_EMAIL=noc.analyst@example.com
TEST_USER_NOC_PASSWORD=REPLACE_ME_with_a_strong_test_password
TEST_USER_NOC_FULL_NAME=NOC Analyst
TEST_USER_NOC_DEPARTMENT=NOC
TEST_USER_NOC_ROLE=NOC Analyst

TEST_USER_IT_SUPPORT_EMAIL=it.support@example.com
TEST_USER_IT_SUPPORT_PASSWORD=REPLACE_ME_with_a_strong_test_password
TEST_USER_IT_SUPPORT_FULL_NAME=IT Support Agent
TEST_USER_IT_SUPPORT_DEPARTMENT=IT Support
TEST_USER_IT_SUPPORT_ROLE=IT Support Agent

# --- AD sync — sync_ad_users.py (REQUIRED, no defaults) -------
LDAP_SERVER=REPLACE_ME_with_your_ad_hostname_or_ip
LDAP_PORT=636
LDAP_BIND_DN=CN=service_account,OU=ServiceAccounts,DC=example,DC=com
# Bind password may be supplied here OR entered interactively by the script:
LDAP_SERVICE_PASSWORD=REPLACE_ME_service_account_password
LDAP_BASE_DN=DC=example,DC=com
LDAP_DOMAIN=example.com
LDAP_FILTER=(objectClass=user)
# Comma-separated AD group DNs whose members get the 'Helpdesk User' role:
LDAP_HELPDESK_GROUPS=CN=IT-Helpdesk,OU=Groups,DC=example,DC=com
LDAP_DEFAULT_ROLE=User
# Comma-separated sAMAccountNames to skip during sync:
LDAP_IGNORE_SAM=ldap_service
# Owner account that sync_ad_users.py never deletes (REQUIRED):
PROTECTED_EMAIL=owner@example.com